# Xcode build output
build/
DerivedData/
*.xcarchive
*.xcuserstate
xcuserdata/

# Release artifacts
dist/
*.dmg

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Secrets -- never commit
Scripts/.env
*.p8

# Local Claude Code config -- machine-specific, not for the repo
.claude/settings.local.json

# Local signing overrides for build-release.sh
Scripts/signing.env

# Local signing config -- set your own team ID here
Config/Local.xcconfig

# Base64 blobs produced when setting up CI secrets. These carry a private key
# (certificates) or signing entitlements (profiles) and must never be committed.
*.b64
*.p12
*.p8
*.mobileprovision
*.provisionprofile
